<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="FIDO Validation Test Plan" enabled="true">
      <stringProp name="TestPlan.comments">Parameterized FIDO validation tests. Provide SERVER_SCHEME, SERVER_HOST, SERVER_PORT and endpoint path variables when running.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="SERVER_SCHEME" elementType="Argument">
            <stringProp name="Argument.name">SERVER_SCHEME</stringProp>
            <stringProp name="Argument.value">https</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SERVER_HOST" elementType="Argument">
            <stringProp name="Argument.name">SERVER_HOST</stringProp>
            <stringProp name="Argument.value">localhost</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SERVER_PORT" elementType="Argument">
            <stringProp name="Argument.name">SERVER_PORT</stringProp>
            <stringProp name="Argument.value">8443</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <!-- Endpoint path variables (override as needed) -->
          <elementProp name="REGISTER_OPTIONS_PATH" elementType="Argument">
            <stringProp name="Argument.name">REGISTER_OPTIONS_PATH</stringProp>
            <stringProp name="Argument.value">/webauthn/register/options</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SUBMIT_CREDENTIAL_PATH" elementType="Argument">
            <stringProp name="Argument.name">SUBMIT_CREDENTIAL_PATH</stringProp>
            <stringProp name="Argument.value">/webauthn/register/submit</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTH_OPTIONS_PATH" elementType="Argument">
            <stringProp name="Argument.name">AUTH_OPTIONS_PATH</stringProp>
            <stringProp name="Argument.value">/webauthn/auth/options</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SUBMIT_ASSERTION_PATH" elementType="Argument">
            <stringProp name="Argument.name">SUBMIT_ASSERTION_PATH</stringProp>
            <stringProp name="Argument.value">/webauthn/auth/submit</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <!-- Payload placeholders: override via -J on CLI or edit values -->
          <elementProp name="REGISTRATION_PAYLOAD" elementType="Argument">
            <stringProp name="Argument.name">REGISTRATION_PAYLOAD</stringProp>
            <stringProp name="Argument.value">{}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="AUTHENTICATION_PAYLOAD" elementType="Argument">
            <stringProp name="Argument.name">AUTHENTICATION_PAYLOAD</stringProp>
            <stringProp name="Argument.value">{}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TAMPERED_SIGNATURE_PAYLOAD" elementType="Argument">
            <stringProp name="Argument.name">TAMPERED_SIGNATURE_PAYLOAD</stringProp>
            <stringProp name="Argument.value">{}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TAMPERED_ATTESTATION_PAYLOAD" elementType="Argument">
            <stringProp name="Argument.name">TAMPERED_ATTESTATION_PAYLOAD</stringProp>
            <stringProp name="Argument.value">{}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"/>
    </TestPlan>
    <hashTree>

      <!-- 1) returns 400 when rpId is missing -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TC-01 rpId missing" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Register Options - missing rpId" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${REGISTER_OPTIONS_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="postBody" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="body" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${REGISTRATION_PAYLOAD}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="TestPlan.comments">Expect 400 when rpId missing</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 400" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="402">400</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="ResponseAssertion.test_field">2</intProp>
          </ResponseAssertion>
        </hashTree>
      </hashTree>

      <!-- 2) returns 400 when rpId is unknown -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TC-02 rpId unknown" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Register Options - unknown rpId" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${REGISTER_OPTIONS_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="postBody" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="body" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <!-- send a payload with rpId set to an unknown value -->
                <stringProp name="Argument.value">{"rpId":"unknown.example","user":{"name":"test"}}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 400" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="402">400</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
        </hashTree>
      </hashTree>

      <!-- 3) returns allowCredentials containing the registered credential id -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TC-03 allowCredentials contains registered id" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
      </ThreadGroup>
      <hashTree>
        <!-- This group assumes you have already registered a credential and will use the user identifier to request auth options -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Auth Options - registered user" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${AUTH_OPTIONS_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="postBody" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="body" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"userId":"registered-user"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Extract allowCredentials.id if present -->
          <JSONPostProcessor guiclass="JsonPostProcessorGui" testclass="JSONPostProcessor" testname="Extract allowCredentials id" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">allowCredId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.allowCredentials[0].id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">0</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert allowCredentials presence" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">allowCredentials</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
        </hashTree>
      </hashTree>

      <!-- 4) responds within 3 seconds for a registered user -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TC-04 response within 3s" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Auth Options - timing" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${AUTH_OPTIONS_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="postBody" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="body" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"userId":"registered-user"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max 3000ms" enabled="true">
            <intProp name="Duration">3000</intProp>
          </DurationAssertion>
        </hashTree>
      </hashTree>

      <!-- Additional test cases: register then authenticate, multiple auths, empty assertion, tampered signature, challenge replay, cache control header, full flow timing, 200 with challenge & rpId, user missing, discoverableCredential invalid, attachment invalid, responds within 3s, completes registration, same username can register again, empty credential submission, tampered attestation, cache-control for register -->

      <!-- For brevity we add a template ThreadGroup that can be duplicated/edited for each remaining case. Each step uses placeholders that you will fill in via CLI or edit. -->

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TC-05 register then authenticate succeeds (template)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">1</intProp>
        </elementProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
      </ThreadGroup>
      <hashTree>
        <!-- 1. REQUEST register options (GET/POST depending on your server) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Register Options (template)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${REGISTER_OPTIONS_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPostProcessor guiclass="JsonPostProcessorGui" testclass="JSONPostProcessor" testname="Extract challenge & rpId" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">challenge,rpId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.challenge,$.rpId</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">0,0</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
        </hashTree>

        <!-- 2. SUBMIT credential (use REGISTRATION_PAYLOAD or provide real payload via -J) -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Submit Registration" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${SUBMIT_CREDENTIAL_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="postBody" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="body" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${REGISTRATION_PAYLOAD}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Extract credential id -->
          <JSONPostProcessor guiclass="JsonPostProcessorGui" testclass="JSONPostProcessor" testname="Extract credential id" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">credentialId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.id,$.rawId</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">0</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
        </hashTree>

        <!-- 3. Request auth options and assert allowCredentials contains credentialId -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Auth Options (template)" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp>
          <stringProp name="HTTPSampler.domain">${SERVER_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${SERVER_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${SERVER_SCHEME}</stringProp>
          <stringProp name="HTTPSampler.path">${AUTH_OPTIONS_PATH}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="postBody" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="body" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"userId":"registered-user"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert allowCredentials contains credentialId" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1">${credentialId}</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
        </hashTree>

      </hashTree>

      <!-- End of template groups. You can duplicate/edit these in JMeter GUI for remaining test cases. -->

    </hashTree>
  </hashTree>
</jmeterTestPlan>
